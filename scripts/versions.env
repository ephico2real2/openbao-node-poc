# Tool and image pins, in ONE place. Sourced by the scripts and by CI.
KIND_VERSION=v0.33.0
# kind and its node image are a pair; deploy/kind/cluster.yaml pins the image by
# digest (a multi-arch index: amd64 and arm64). scripts/preflight.sh checks they agree.
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KUBECTL_MIN_VERSION=v1.35.0   # one minor below the node image is inside kubectl's skew
NODE_MIN_MAJOR=22             # the check scripts and the capture walk
KIND_CLUSTER=secure-notes-bao
NAMESPACE=secure-notes

# Built by `docker compose build` (docker-compose.yml) and used unchanged by
# Docker Compose and kind, then published to GHCR.
APP_IMAGE=secure-notes-app:dev
MOCK_IMAGE=secure-notes-aws-mock:dev

# Third-party images both stacks run; preloaded into kind so no pod waits on Docker Hub.
POSTGRES_IMAGE=docker.io/library/postgres:16
REDIS_IMAGE=docker.io/library/redis:7-alpine

# OpenBao (steps/v1-openbao-kv): the server image the Compose step runs (the
# same literal is in steps/v1-openbao-kv/compose.yaml; CI checks they agree),
# and the release binary the unit tests start (checksum from the release's
# checksums-linux.txt). https://github.com/openbao/openbao/releases/tag/v2.7.1
OPENBAO_VERSION=2.7.1
OPENBAO_IMAGE=docker.io/openbao/openbao:2.7.1
OPENBAO_LINUX_AMD64_SHA256=0e2f1ce10d124e03112b50dd2fbec6b78003783253bc3a91587938f39d1e2243
# Step v3: the OpenBao Helm chart (appVersion v2.7.1), from the openbao-helm
# GitHub release; the checksum is the one in its .prov file.
OPENBAO_CHART_VERSION=0.30.4
OPENBAO_CHART_SHA256=f9d464f0288a96374fcddb33abb31bc3f134ccaa32da3e4cf272f143b34bb96b
# Step v3 (file mode): External Secrets Operator's Helm chart, from its GitHub
# release; the checksum is the one in its .prov file.
ESO_CHART_VERSION=2.13.0
ESO_CHART_SHA256=f693a96f0d929a07e000dd39e68b92a1a1343c5bc440ebab091b03da30bcac3a
# Step v2/v3: Valkey replaces Redis where OpenBao manages the cache users.
VALKEY_IMAGE=docker.io/valkey/valkey:8.1-alpine

# The browser walk that photographs the dashboard (same pin as cilium-implementation-poc).
PLAYWRIGHT_VERSION=1.63.0
JS_YAML_VERSION=4.1.0

# Supply chain (scripts/scan-images.sh): SBOM with syft, vulnerability scan with
# grype. Release tarballs are checked against the release's checksums file.
SYFT_VERSION=v1.52.0
GRYPE_VERSION=v0.119.0
# cosign signs the published images (.github/workflows/ci.yaml, images job).
COSIGN_VERSION=v3.1.3
