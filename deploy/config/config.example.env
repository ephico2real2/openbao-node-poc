# Secure Notes: the same settings as config.example.yaml, as KEY=VALUE.
# Use as an env file (podman --env-file, systemd EnvironmentFile, a Kustomize
# configMapGenerator) or with APP_CONFIG_FILE=/etc/secure-notes/config.env.
SECRETS_ENV=prod
SECRETS_APP=secure-notes
SECRETS_NAME_PATTERN=/{service}/{env}/{resource}/{name}
DB_SECRET_ID=arn:aws:secretsmanager:us-east-1:111122223333:secret:rds!db-0a1b2c3d-AbCdEf
REDIS_SECRET_SERVICE=elasticache
REDIS_SECRET_RESOURCE=secure-notes
REDIS_SECRET_NAME=app
